# Anthropic
ANTHROPIC_API_KEY=

# HubSpot private app token (enrichment, not a send channel)
HUBSPOT_ACCESS_TOKEN=

# Microsoft Graph — Outlook email sending
# Azure App Registration with Mail.Send (application permission)
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER_UPN=nick@henleycontracting.com

# OpenPhone / Quo — SMS + voice
OPENPHONE_API_KEY=
OPENPHONE_FROM_NUMBER=

# Meta WhatsApp Business
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=

# Meta Graph — Messenger + Instagram DM
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=

# Server
PORT=3000

# Pipeline
DEFAULT_LOOKBACK_DAYS=30

# HubSpot owner ID for Nick (used when assigning follow-up tasks)
NICK_HUBSPOT_OWNER_ID=
