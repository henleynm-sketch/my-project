{
  "name": "henley-outreach",
  "version": "0.1.0",
  "description": "HubSpot-integrated LinkedIn outreach drafting tool for Nick Henley. Drafts and logs only — never sends.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "ingest": "node src/pipeline/ingest.js",
