    "test:hubspot": "node src/connectors/hubspot.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@hubspot/api-client": "^12.0.1",
    "better-sqlite3": "^11.3.0",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.1"
  }
}
