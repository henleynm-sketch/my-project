{
  "name": "henley-outreach",
  "version": "0.1.0",
  "description": "Omnichannel outreach hub for Nick Henley. Auto-sends email/SMS/WhatsApp/Meta; surfaces LinkedIn as a ranked action list.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "ingest": "node src/pipeline/ingest.js",
    "followups": "node -e \"import('./src/pipeline/followups.js').then(m => m.checkDue())\"",
    "test:hubspot": "node src/connectors/hubspot.js",
    "test:connectors": "node src/scripts/testConnectors.js",
    "draft": "node src/scripts/draftOne.js",
    "rescore": "node src/routing/score.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@hubspot/api-client": "^12.0.1",
    "better-sqlite3": "^11.3.0",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "xlsx": "^0.18.5"
  }
}
