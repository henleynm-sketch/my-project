# ============================================================
# Buildertrend Login Credentials
# ============================================================
# Your normal Buildertrend username (email) and password.
# This is what you use to log in at buildertrend.net.

BT_USERNAME=your_email@example.com
BT_PASSWORD=your_buildertrend_password

# Login URL (change only if your company uses a custom BT domain)
BT_LOGIN_URL=https://buildertrend.net

# ============================================================
# Google Drive — Service Account Credentials
# ============================================================
# Path to the JSON key file you downloaded from Google Cloud Console.
# Example: /home/youruser/credentials/service_account.json

GOOGLE_SERVICE_ACCOUNT_FILE=path/to/your/service_account.json

# The ID of the shared Google Drive folder where the
# /Marketing/Active Projects/... structure lives.
# To find a folder ID: open the folder in Google Drive,
# copy the long string at the end of the URL.

GOOGLE_DRIVE_ROOT_FOLDER_ID=your_google_drive_folder_id_here

# ============================================================
# Options
# ============================================================

# Run browser in headless mode (no visible window).
# Set to "false" for debugging — you'll see the browser click through BT.
HEADLESS=true

# Where to write the log file. Defaults to ./sync.log
LOG_FILE=sync.log
