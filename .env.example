# ============================================================
# Buildertrend API Credentials
# ============================================================
# Get these from your Buildertrend account rep or developer portal.
# See README.md for detailed instructions.

BT_CLIENT_ID=your_buildertrend_client_id_here
BT_CLIENT_SECRET=your_buildertrend_client_secret_here

# Base URL for the Buildertrend API (do not change unless instructed)
BT_API_BASE_URL=https://api.buildertrend.net

# ============================================================
# Google Drive — Service Account Credentials
# ============================================================
# Path to the JSON key file you downloaded from Google Cloud Console.
# Example: /home/youruser/credentials/service_account.json

GOOGLE_SERVICE_ACCOUNT_FILE=path/to/your/service_account.json

# The ID of the shared Google Drive (or "My Drive" root folder ID)
# where the /Marketing/Active Projects/... structure lives.
# To find a folder ID: open the folder in Google Drive, copy
# the long string at the end of the URL.

GOOGLE_DRIVE_ROOT_FOLDER_ID=your_google_drive_folder_id_here

# ============================================================
# Logging
# ============================================================
# Where to write the daily log file. Defaults to ./sync.log
LOG_FILE=sync.log
